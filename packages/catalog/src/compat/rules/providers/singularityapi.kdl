// SingularityAPI reserved-inference gateway (api.singularityapi.tech, a
// LiteLLM front end for reserved DeepSeek lanes). The live `/v1/models`
// roster owns membership: keys are lane-scoped `sk-...` bearer tokens issued
// from the dashboard, and a bogus key is rejected with 401
// `token_not_found_in_db` (verified 2026-09-21), so no rows are frozen here.
// Deliberately no `discovery` node: that node enrolls a provider in
// generate-models.ts, which would freeze one account's lane snapshot into
// models.json. The roster is per-key credential-scoped, so the provider stays
// runtime-only and `dynamic-models-authoritative` prunes stale rows.
provider "singularityapi" {
	default-model "deepseek-ai/DeepSeek-V4.1-Flash"
	env "SINGULARITYAPI_API_KEY"
	dynamic-models-authoritative #true

	// Model guide (dashboard): the lane runs DeepSeek V4.1 Flash. Send
	// `deepseek-ai/DeepSeek-V4.1-Flash`; the short alias
	// `deepseek-v4.1-flash` is accepted too. Context is 262,144 tokens
	// prompt+completion (not the documented 1M); an overflowing max_tokens
	// is reduced automatically, and a prompt within ~1K of the limit 400s.
	// Both ids classify deepseek/flash by taxonomy, but bare `/v1/models`
	// rows carry no reasoning metadata, so neutral discovery would leave
	// the effort dial dark.
	// Glob (not exact) selectors: cascade `exact` matching is
	// case-sensitive while the compiler lowercases exact values, so an
	// exact rule could never match the wire's mixed-case ids.
	models "*deepseek-v4-flash-0731" "*deepseek-v4.1-flash" {
		thinking-upgrade-neutral #true
		max-tokens-field "max_tokens"
		// Guide effort vocabulary: low, high, xhigh, max, integer 1-100,
		// and "none" to force off (off by default). Integers have no
		// catalog axis; the named ladder is owned here.
		thinking-efforts "low" "high" "xhigh" "max"
		reasoning-disable-mode "none-effort"
		// Reasoning streams as message.reasoning / delta.reasoning.
		reasoning-content-field "reasoning"
		clamp-output-to-model-max #true
		// Guide: up to 8 image_url parts per request (PNG/JPEG, data URL
		// or public https). Declared here as well as clearing the class
		// strip: live discovery seeds input ["text"], and the wire guard
		// requires the declared modality.
		input-modalities "text" "image"
		strip-image-input #false
		limits-patch {
			context-window 262144
		}
	}
}
